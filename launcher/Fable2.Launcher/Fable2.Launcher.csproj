<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Fable2Launcher</AssemblyName>
    <AssemblyTitle>Fable 2 Recompiled Launcher</AssemblyTitle>
    <Product>Fable 2 Recompiled</Product>
    <ApplicationIcon>..\..\assets\app-icon.ico</ApplicationIcon>
    <RootNamespace>Fable2Launcher</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\constants\GameVersions.cs" Link="Constants\GameVersions.cs" />
    <Resource Include="..\..\assets\app-icon.png" Link="Assets\app-icon.png" />
  </ItemGroup>
</Project>
